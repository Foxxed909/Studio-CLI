{
  "manifest_version": 3,
  "name": "StudioCLI Companion",
  "version": "1.2",
  "description": "Browser control companion for StudioCLI. Screen capture and AI-driven automation.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://localhost:*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    },
    "default_title": "StudioCLI Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle StudioCLI screen capture"
    }
  }
}
